      "summary": null,
      "created_at": "2026-08-07T10:00:00"
    },
    {
      "id": "00000000-0000-0000-0000-0000000003ea",
      "session_id": "00000000-0000-0000-0000-000000000002",
      "sequence_num": 2,
      "event_type": "action",
      "actor_id": null,
      "actor_name": "沈砚",
      "content": "我问他，接头的时候怎么认人。",
      "visibility": [],
      "metadata": {
        "scene_id": "scene_pawnshop"
      },
      "summary": null,
      "created_at": "2026-08-07T10:00:00"
