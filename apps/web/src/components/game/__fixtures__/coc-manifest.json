      "config_schema": {
        "description": "coc7.sanity：临时疯狂的触发口径。",
        "properties": {
          "insanity_rule": {
            "default": "fifth_of_san",
            "enum": [
              "fifth_of_san",
              "flat"
            ],
            "title": "临时疯狂口径",
            "type": "string",
            "x-choices": [
              {
                "hint": "单次损失 ≥ 当前 SAN 的五分之一",
                "label": "SAN 的 1/5",
                "value": "fifth_of_san"
              },
              {
                "hint": "单次损失达到固定点数",
                "label": "固定点数",
                "value": "flat"
              }
            ]
          },
          "insanity_flat_threshold": {
            "default": 5,
            "description": "规则书原文是 5",
            "maximum": 99,
            "minimum": 1,
            "title": "固定点数",
            "type": "integer",
            "x-show-if": {
              "insanity_rule": "flat"
            }
          }
        },
        "title": "SanityConfig",
        "type": "object"
      }
