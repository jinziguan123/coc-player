    {
      "id": "coc7.growth",
      "title": "技能成长",
      "description": "关掉则模组结束时不做成长检定（短模组常这么跑）",
      "group": "伤害与状态",
      "toggle": "improvement",
      "requires": [
        "coc7.check"
      ],
      "conflicts": [],
      "config_schema": {
        "description": "coc7.growth：技能成长（默认开；一夜之间的短模组常关掉）。",
        "properties": {
          "improvement": {
            "default": true,
            "title": "技能成长",
            "type": "boolean"
          }
        },
        "title": "GrowthConfig",
        "type": "object"
      }
    }
