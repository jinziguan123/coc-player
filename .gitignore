node_modules/
dist/
build/
.vite/
*.tsbuildinfo

__pycache__/
*.py[cod]
*.egg-info/
.venv/
*.db
*.db-wal
*.db-shm

# 用户上传的地图素材（运行时文件，不入库）
server/data/
# 文生图与场景图缓存（运行时文件，不入库）
server/images/
# 嵌入模型缓存（fastembed 首次使用时下载 bge-small-zh-v1.5，~90MB，运行时重下，不入库）
server/models/
# 打包用的内置种子（由 make_seed.py 从开发库生成，构建时重建，不入库）
server/seed/
# 评估 scorecard 运行产物（本地对比用，不入库；fixtures/ 入库）
server/evals/results/

.env
# 含 AI 密钥，不入库（密钥应从 .env / 设置页注入）
ai_settings.json
# 本机的联机策略（局域网开关、房间 AI 配额），属于个人环境设置，不入库
net_settings.json
ai_quota.json
.DS_Store
target/
.claude/
.worktrees/
# 本地开发工具配置（mcporter 等 MCP 工具管理器，与应用无关）
config/

# Tauri 打包：Rust 产物、生成的 schema、以及按平台构建的后端产物（由脚本重建）
src-tauri/gen/
src-tauri/binaries/
# resources/ 的内容由打包流程生成，但目录本身必须留一个文件在库里：
# Tauri 的 bundle.resources glob 匹配不到任何文件就直接报错，开发态会连
# cargo check / cargo test 都跑不起来。原因写在那个 README 里。
src-tauri/resources/*
!src-tauri/resources/README.md
server/trpg.db.bak-*
